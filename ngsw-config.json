{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/assets/data/*.json",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"],
        "urls": ["https://images.unsplash.com/**", "https://upload.wikimedia.org/**", "https://commons.wikimedia.org/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "external-images",
      "urls": [
        "https://images.unsplash.com/**",
        "https://upload.wikimedia.org/**",
        "https://commons.wikimedia.org/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "30d",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
